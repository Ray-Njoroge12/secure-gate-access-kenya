# Production Environment Configuration
# Copy this file to .env.production and fill in your actual values

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SMS Provider - Africa's Talking (Primary)
AFRICASTALKING_API_KEY=your-africastalking-api-key
AFRICASTALKING_USERNAME=your-africastalking-username
AFRICASTALKING_SENDER_ID=SECGATE

# SMS Provider - Twilio (Backup)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+254xxxxxxxxx

# Maps Configuration
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
MAPS_DEFAULT_REGION=KE
MAPS_DEFAULT_CENTER_LAT=-1.2921
MAPS_DEFAULT_CENTER_LNG=36.8219

# WhatsApp Business API
WHATSAPP_API_TOKEN=your-whatsapp-business-api-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# Security Configuration
JWT_SECRET=your-jwt-secret-key
ENCRYPTION_KEY=your-encryption-key
SESSION_SECRET=your-session-secret

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_SMS_PER_DAY=100

# Kenya-specific Settings
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,sw
TIMEZONE=Africa/Nairobi
COUNTRY_CODE=+254

# Monitoring & Analytics
SENTRY_DSN=your-sentry-dsn
MIXPANEL_TOKEN=your-mixpanel-token
LOG_LEVEL=info

# Feature Flags
ENABLE_SMS_NOTIFICATIONS=true
ENABLE_WHATSAPP_NOTIFICATIONS=true
ENABLE_PANIC_ALERTS=true
ENABLE_CAB_FAST_LANE=true
ENABLE_MULTI_DEVICE_LOGIN=true
ENABLE_OFFLINE_MODE=true

# Deployment Configuration
NODE_ENV=production
API_BASE_URL=https://api.yourdomain.com
FRONTEND_URL=https://yourdomain.com
