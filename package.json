{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:staging": "vite build --mode staging",
    "build:production": "vite build --mode production",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "verify:env": "node scripts/verify-test-environment.mjs",
    "test:unit": "vitest run src/**/*.test.{ts,tsx}",
    "test:integration": "vitest run tests/integration/**/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:system": "cross-env INTEGRATION_TESTS=1 vitest run tests/system-integrity-tests.ts",
    "test:system:debug": "cross-env INTEGRATION_TESTS=1 DEBUG_TESTS=1 vitest run tests/system-integrity-tests.ts",
    "test:system-report": "cross-env INTEGRATION_TESTS=1 tsx tests/run-system-tests.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:security": "vitest run tests/security/**/*.test.ts",
    "test:compliance": "vitest run tests/security/compliance.test.ts",
    "test:performance": "artillery run tests/performance/load-test.yml",
    "test:load": "artillery run tests/performance/load-test.yml --output load-test-report.json",
    "test:smoke": "playwright test tests/e2e/smoke.spec.ts",
    "test:smoke:staging": "E2E_BASE_URL=https://staging.secure-gate-kenya.com playwright test tests/e2e/smoke.spec.ts",
    "test:smoke:production": "E2E_BASE_URL=https://secure-gate-kenya.com playwright test tests/e2e/smoke.spec.ts",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test:gdpr": "vitest run tests/security/gdpr.test.ts",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "db:setup:test": "supabase db reset --local",
    "db:migrate": "supabase db push",
    "db:seed": "supabase seed",
    "deploy:staging": "vercel --target staging",
    "deploy:production": "vercel --target production",
    "security:audit": "npm audit",
    "security:scan": "trivy fs .",
    "compliance:report": "vitest run tests/security/compliance.test.ts --reporter=json --outputFile=compliance-report.json",
    "verify:tenants": "node scripts/verify-tenant-isolation.js",
    "lighthouse": "lhci autorun",
    "analyze:bundle": "npx vite-bundle-analyzer",
    
    "test:env-config": "vitest run tests/infrastructure/env-config.test.ts",
    "validate:environment-isolation": "vitest run tests/infrastructure/environment-isolation.test.ts",
    "test:ci-pipeline": "vitest run tests/infrastructure/ci-pipeline.test.ts",
    "validate:automated-deployment": "vitest run tests/infrastructure/deployment.test.ts",
    "test:production-env-vars": "vitest run tests/infrastructure/production-env.test.ts",
    "validate:production-readiness": "vitest run tests/infrastructure/production-readiness.test.ts",
    
    "performance:bundle-analysis": "npm run analyze:bundle && npm run performance:report-bundle",
    "performance:lighthouse-audit": "lighthouse http://localhost:8081 --output=json --output-path=./reports/lighthouse.json",
    "test:load-testing-production": "artillery run tests/performance/production-load.yml",
    "test:stress-testing": "artillery run tests/performance/stress-test.yml",
    "test:performance-regression": "vitest run tests/performance/regression.test.ts",
    "performance:runtime-validation": "vitest run tests/performance/runtime.test.ts",
    "performance:memory-analysis": "vitest run tests/performance/memory.test.ts",
    "performance:report-bundle": "node scripts/bundle-analysis-report.js",
    
    "test:ml-model-accuracy": "vitest run tests/ai/model-accuracy.test.ts",
    "validate:pattern-recognition": "vitest run tests/ai/pattern-recognition.test.ts",
    "test:anomaly-detection-advanced": "vitest run tests/ai/anomaly-detection.test.ts",
    "test:ai-response-time": "vitest run tests/ai/response-time.test.ts",
    "validate:prediction-accuracy": "vitest run tests/ai/prediction-accuracy.test.ts",
    "test:ai-scalability": "vitest run tests/ai/scalability.test.ts",
    
    "docs:api-validation": "vitest run tests/documentation/api-validation.test.ts",
    "test:api-documentation-accuracy": "vitest run tests/documentation/api-accuracy.test.ts",
    "validate:deployment-guides": "vitest run tests/documentation/deployment-guides.test.ts",
    "docs:coverage-check": "vitest run tests/documentation/coverage.test.ts",
    "validate:user-manuals": "vitest run tests/documentation/user-manuals.test.ts",
    "test:developer-documentation": "vitest run tests/documentation/developer-docs.test.ts",
    
    "test:e2e:production": "E2E_BASE_URL=https://secure-gate-kenya.com playwright test",
    "test:security:comprehensive": "vitest run tests/security/comprehensive.test.ts",
    "validate:system-complete": "vitest run tests/final/system-complete.test.ts",
    "test:all-phases": "npm run test:ci-pipeline && npm run test:performance-regression && npm run test:ml-model-accuracy && npm run docs:api-validation && npm run validate:system-complete",
    "validate:production-complete": "node scripts/production-readiness-check.js",
    "deploy:fix": "node scripts/fix-deployment.mjs",
    "ui:enhance": "node scripts/enhance-ui.mjs",
    "fix:all": "npm run deploy:fix && npm run test:unit && npm run build:production"
  },
